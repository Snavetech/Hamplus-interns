# ====================================================================
# HAMPLUS INTERN PORTAL - ENVIRONMENT VARIABLES
# Hamplus Hub, Abraka, Delta State, Nigeria
# ====================================================================

# Frontend Public Credentials (Safe for browser use)
# Found in: Supabase Project Settings > API > Project URL & anon/public key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Server-Side Only / CLI Provisioning
# WARNING: NEVER expose SUPABASE_SERVICE_ROLE_KEY to frontend browser code!
# SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key

# Automated Welcome Email Service (Configured in Vercel / Server Environment)
# 1. Resend (Recommended - 3,000 free emails/month at https://resend.com)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Hamplus Hub <onboarding@resend.dev>

# 2. Brevo Alternative (Optional)
# BREVO_API_KEY=your_brevo_api_key
# EMAIL_FROM_ADDRESS=onboarding@hamplus.com
# EMAIL_FROM_NAME=Hamplus Hub Abraka
